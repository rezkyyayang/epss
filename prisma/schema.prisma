generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum PeriodStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  RESUBMITTED
  APPROVED
}

enum ResponseStatus {
  PENDING
  NEEDS_REVISION
  APPROVED
}

enum ReviewOutcome {
  APPROVE
  REQUEST_REVISION
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  displayName      String
  passwordHash     String
  role             UserRole        @default(USER)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  memberships      Membership[]
  sessions         Session[]
  createdAssessments Assessment[]  @relation("AssessmentCreator")
  addedEvidence    Evidence[]      @relation("EvidenceAuthor")
  reviewDecisions  ReviewDecision[]
  statusEvents     StatusEvent[]
  auditEvents      AuditEvent[]

  @@index([role, isActive])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginThrottle {
  keyHash       String   @id
  failedAttempts Int     @default(0)
  blockedUntil  DateTime?
  updatedAt     DateTime @updatedAt

  @@index([blockedUntil])
}

model Unit {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  periodAssignments PeriodAssignment[]
  assessments Assessment[]

  @@index([isActive, name])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  unitId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([userId, unitId])
  @@index([unitId, userId])
}

model Period {
  id          String        @id @default(cuid())
  name        String
  startsAt    DateTime?
  endsAt      DateTime?
  status      PeriodStatus  @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  domains     Domain[]
  assignments PeriodAssignment[]
  assessments Assessment[]

  @@index([status, startsAt, endsAt])
}

model PeriodAssignment {
  id        String   @id @default(cuid())
  periodId  String
  unitId    String
  createdAt DateTime @default(now())
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([periodId, unitId])
  @@index([unitId, periodId])
}

// Weights are whole percentages. Domain weights in a period sum to 100,
// and indicator weights within one domain sum to 100.
model Domain {
  id         String      @id @default(cuid())
  periodId   String
  code       String
  name       String
  weight     Int
  position   Int         @default(0)
  period     Period      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  indicators Indicator[]

  @@unique([periodId, code])
  @@index([periodId, position])
}

model Indicator {
  id              String                 @id @default(cuid())
  domainId        String
  code            String
  title           String
  criterion       String                 @default("")
  weight          Int
  requiresEvidence Boolean                @default(false)
  position        Int                    @default(0)
  domain          Domain                 @relation(fields: [domainId], references: [id], onDelete: Restrict)
  maturityLevels  MaturityLevel[]
  responses       AssessmentResponse[]

  @@unique([domainId, code])
  @@index([domainId, position])
}

model MaturityLevel {
  id          String     @id @default(cuid())
  indicatorId String
  level       Int
  criterion   String
  indicator   Indicator  @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  responses   AssessmentResponse[]

  @@unique([indicatorId, level])
  @@index([indicatorId, level])
}

model Assessment {
  id               String           @id @default(cuid())
  periodId         String
  unitId           String
  createdById      String
  status           AssessmentStatus @default(DRAFT)
  submittedAt      DateTime?
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  period           Period           @relation(fields: [periodId], references: [id], onDelete: Restrict)
  unit             Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responses        AssessmentResponse[]
  statusEvents     StatusEvent[]

  @@unique([periodId, unitId])
  @@index([unitId, status, updatedAt])
  @@index([periodId, status])
  @@index([createdById, updatedAt])
}

model AssessmentResponse {
  id                String          @id @default(cuid())
  assessmentId      String
  indicatorId       String
  maturityLevelId   String?
  explanation       String          @default("")
  status            ResponseStatus  @default(PENDING)
  version           Int             @default(1)
  updatedAt         DateTime        @updatedAt
  assessment        Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  indicator         Indicator      @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  maturityLevel     MaturityLevel? @relation(fields: [maturityLevelId], references: [id], onDelete: Restrict)
  evidence          Evidence[]
  decisions         ReviewDecision[]

  @@unique([assessmentId, indicatorId])
  @@index([assessmentId, status])
}

model Evidence {
  id             String             @id @default(cuid())
  responseId     String
  addedById      String
  url            String
  createdAt      DateTime           @default(now())
  response       AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  addedBy        User               @relation("EvidenceAuthor", fields: [addedById], references: [id], onDelete: Restrict)

  @@index([responseId, createdAt])
}

model ReviewDecision {
  id              String       @id @default(cuid())
  responseId      String
  reviewerId      String
  outcome         ReviewOutcome
  comment         String       @default("")
  reviewedVersion Int
  createdAt       DateTime     @default(now())
  response        AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  reviewer        User         @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([responseId, reviewedVersion])
  @@index([reviewerId, createdAt])
}

model StatusEvent {
  id           String           @id @default(cuid())
  assessmentId String
  actorId      String?
  fromStatus   AssessmentStatus?
  toStatus     AssessmentStatus
  reason       String?
  createdAt    DateTime         @default(now())
  assessment  Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  actor       User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([assessmentId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
